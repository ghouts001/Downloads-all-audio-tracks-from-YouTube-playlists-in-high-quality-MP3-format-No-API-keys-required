#!/usr/bin/env python3
"""
Complete YouTube Playlist Audio Downloader
Downloads all audio tracks from YouTube playlists in high quality MP3 format
No API keys required - works directly with any public playlist

Created by: DexterLaboratory
"""

import os
import sys
import subprocess
import time
from pathlib import Path

def check_and_install_dependencies():
    """Check and install required packages"""
    print("🔍 Checking dependencies...")
    
    # Check for yt-dlp
    try:
        import yt_dlp
        print("✓ yt-dlp is installed")
    except ImportError:
        print("📦 Installing yt-dlp...")
        try:
            subprocess.check_call([sys.executable, "-m", "pip", "install", "yt-dlp"])
            print("✓ yt-dlp installed successfully")
        except subprocess.CalledProcessError:
            print("❌ Failed to install yt-dlp. Please run: pip install yt-dlp")
            sys.exit(1)
    
    # Check for ffmpeg (optional but recommended)
    try:
        subprocess.run(["ffmpeg", "-version"], capture_output=True, check=True)
        print("✓ FFmpeg is available")
    except (subprocess.CalledProcessError, FileNotFoundError):
        print("⚠️  FFmpeg not found. Audio conversion may be limited.")
        print("   Install FFmpeg for best results: https://ffmpeg.org/download.html")

def get_playlist_info(url):
    """Get playlist information without downloading"""
    import yt_dlp
    
    ydl_opts = {
        'quiet': True,
        'no_warnings': True,
        'extract_flat': True,
    }
    
    try:
        with yt_dlp.YoutubeDL(ydl_opts) as ydl:
            info = ydl.extract_info(url, download=False)
            return {
                'title': info.get('title', 'Unknown Playlist'),
                'count': len(info.get('entries', [])),
                'uploader': info.get('uploader', 'Unknown')
            }
    except Exception as e:
        print(f"❌ Error getting playlist info: {e}")
        return None

def download_playlist_audio(playlist_url, output_dir="YouTube_Downloads", quality="192"):
    """
    Download all audio from YouTube playlist
    
    Args:
        playlist_url (str): YouTube playlist URL
        output_dir (str): Output directory name
        quality (str): Audio quality (128, 192, 256, 320)
    """
    import yt_dlp
    
    # Create output directory
    output_path = Path(output_dir)
    output_path.mkdir(exist_ok=True)
    
    print(f"📁 Output directory: {output_path.absolute()}")
    
    # Configure download options
    ydl_opts = {
        'format': 'bestaudio/best',
        'outtmpl': str(output_path / '%(playlist_index)02d - %(uploader)s - %(title)s.%(ext)s'),
        'ignoreerrors': True,
        'no_warnings': False,
        'extractaudio': True,
        'audioformat': 'mp3',
        'audioquality': quality,
        'embed_subs': False,
        'writesubtitles': False,
        'writeautomaticsub': False,
        'writethumbnail': False,
        'writeinfojson': False,
        'postprocessors': [{
            'key': 'FFmpegExtractAudio',
            'preferredcodec': 'mp3',
            'preferredquality': quality,
        }],
        'postprocessor_args': [
            '-ar', '44100',  # Sample rate
        ],
    }
    
    # Progress hook
    def progress_hook(d):
        if d['status'] == 'downloading':
            percent = d.get('_percent_str', 'N/A')
            speed = d.get('_speed_str', 'N/A')
            print(f"\r🔽 Downloading: {percent} at {speed}", end='', flush=True)
        elif d['status'] == 'finished':
            print(f"\n✅ Downloaded: {os.path.basename(d['filename'])}")
    
    ydl_opts['progress_hooks'] = [progress_hook]
    
    try:
        with yt_dlp.YoutubeDL(ydl_opts) as ydl:
            print("🎵 Starting playlist download...")
            ydl.download([playlist_url])
            return True
    except Exception as e:
        print(f"\n❌ Download error: {e}")
        return False

def clean_filename(filename):
    """Remove invalid characters from filename"""
    invalid_chars = '<>:"/\\|?*'
    for char in invalid_chars:
        filename = filename.replace(char, '')
    return filename.strip()

def main():
    """Main function"""
    print("=" * 60)
    print("🎵 YOUTUBE PLAYLIST AUDIO DOWNLOADER 🎵")
    print("=" * 60)
    print("No API keys required | High quality MP3 downloads")
    print("Created by: DexterLaboratory")
    print("-" * 60)
    
    # Check dependencies
    check_and_install_dependencies()
    print()
    
    # Get playlist URL
    if len(sys.argv) > 1:
        playlist_url = sys.argv[1]
        print(f"📋 Using playlist URL from command line")
    else:
        print("📋 Enter your YouTube playlist URL:")
        print("   Example: https://www.youtube.com/watch?v=0LexIVAJ2q8&list=PL_Lsy8ipoW__f-EfDVlFCpm9yzipMHfM5&pp=gAQB")
        playlist_url = input("🔗 URL: ").strip()
    
    # Validate URL
    if not playlist_url:
        print("❌ No URL provided!")
        return
    
    if "playlist" not in playlist_url and "list=" not in playlist_url:
        print("❌ This doesn't look like a playlist URL!")
        print("   Make sure the URL contains 'playlist' or 'list='")
        return
    
    print(f"\n🔍 Analyzing playlist...")
    
    # Get playlist info
    playlist_info = get_playlist_info(playlist_url)
    if playlist_info:
        print(f"📝 Playlist: {playlist_info['title']}")
        print(f"👤 Creator: {playlist_info['uploader']}")
        print(f"🎵 Songs: {playlist_info['count']}")
    
    # Get output directory
    if len(sys.argv) > 2:
        output_dir = sys.argv[2]
    else:
        default_dir = "YouTube_Downloads"
        output_input = input(f"\n📁 Output folder (press Enter for '{default_dir}'): ").strip()
        output_dir = output_input if output_input else default_dir
    
    # Get quality preference
    if len(sys.argv) > 3:
        quality = sys.argv[3]
    else:
        print("\n🎧 Audio Quality Options:")
        print("   1. High (320 kbps)")
        print("   2. Good (192 kbps) - Recommended")
        print("   3. Standard (128 kbps)")
        
        quality_choice = input("Choose quality (1-3, press Enter for 2): ").strip()
        quality_map = {"1": "320", "2": "192", "3": "128"}
        quality = quality_map.get(quality_choice, "192")
    
    print(f"\n⚙️  Settings:")
    print(f"   📁 Output: {output_dir}")
    print(f"   🎧 Quality: {quality} kbps MP3")
    print(f"   🔗 URL: {playlist_url}")
    
    # Confirm download
    confirm = input("\n▶️  Start download? (y/N): ").strip().lower()
    if confirm not in ['y', 'yes']:
        print("❌ Download cancelled.")
        return
    
    print(f"\n🚀 Starting download...")
    print("=" * 60)
    
    start_time = time.time()
    
    # Download playlist
    success = download_playlist_audio(playlist_url, output_dir, quality)
    
    end_time = time.time()
    duration = end_time - start_time
    
    print("\n" + "=" * 60)
    if success:
        print("🎉 DOWNLOAD COMPLETED!")
        print(f"⏱️  Time taken: {duration:.1f} seconds")
        print(f"📁 Files saved to: {Path(output_dir).absolute()}")
        print("\n🎵 Enjoy your music!")
    else:
        print("❌ Download failed or incomplete.")
        print("💡 Tips:")
        print("   - Check your internet connection")
        print("   - Verify the playlist URL is correct")
        print("   - Make sure the playlist is public")
    
    print("=" * 60)
    print("☕ Support the developer: buymeacoffee.com/dexterlaboc")
    print("=" * 60)

if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\n\n⏹️  Download interrupted by user.")
        sys.exit(0)
    except Exception as e:
        print(f"\n❌ Unexpected error: {e}")
        sys.exit(1)
